# Gemini LLM
GEMINI_API_KEY=

# Pexels
PEXELS_API_KEY=

# Pinterest
PINTEREST_ENABLED=true

# AceMusic
ACEMUSIC_API_KEY=

# Colab image generation (optional; required for the external image adapter)
COLAB_IMAGE_API_URL=https://your-tunnel.loca.lt/generate
COLAB_IMAGE_BYPASS_PASSWORD=
COLAB_IMAGE_API_KEY=
COLAB_IMAGE_TIMEOUT_SECONDS=180
ACEMUSIC_ENABLED=true

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5001/callback

# Video Configuration
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
FFMPEG_PRESET=ultrafast
FFMPEG_CRF=20
FFMPEG_AUDIO_BITRATE=192k
TARGET_DURATION_MINUTES=90
WAVEFORM_ENABLED=true
WAVEFORM_FILTER_ENABLED=true
WAVEFORM_VERTICAL_POSITION_RATIO=0.80
WAVEFORM_BAR_WIDTH=3
WAVEFORM_OPACITY=0.90
WAVEFORM_HEIGHT_RATIO=0.03
WAVEFORM_WIDTH_RATIO=0.50
# Legacy bottom padding is retained for compatibility; vertical anchor controls placement.
WAVEFORM_BOTTOM_PADDING_RATIO=0.04
WAVEFORM_COLOR=0x000000
WATERMARK_ENABLED=true
WATERMARK_WIDTH_RATIO=0.016667
WATERMARK_RIGHT_PADDING_RATIO=0.02
WATERMARK_BOTTOM_PADDING_RATIO=0.02
WATERMARK_OPACITY=0.35

# Optional six-second decorative waveform, bottom-left. No audio analysis or music disc.
VISUALIZER_ENABLED=false
VISUALIZER_MUSIC_DISK_PATH=asset/music-disk.gif
VISUALIZER_SOUNDWAVE_PATH=asset/soundwave.gif
VISUALIZER_COMBINED_WIDTH_RATIO=0.25
VISUALIZER_BOTTOM_PADDING_RATIO=0.02
VISUALIZER_RIGHT_PADDING_RATIO=0.01
VISUALIZER_OPACITY=1.0

# Optional silent subscribe WebM overlay. Auto-selects the first WebM in subscribeVideo/.
SUBSCRIBE_OVERLAY_ENABLED=true
SUBSCRIBE_OVERLAY_WIDTH_RATIO=0.17

# Long-form audio/image optimization
AUDIO_LOOP_TRACK_COUNT=3
AUDIO_ENABLE_LOOPING=true
AUDIO_DURATION_TOLERANCE_SECONDS=5
# Optional audio processing: false = plain sequential concat (fast), true = crossfade/loudnorm/fades
AUDIO_CROSSFADE_ENABLED=true
AUDIO_LOUDNESS_ENABLED=true
AUDIO_FADES_ENABLED=true
COLAB_IMAGE_ENABLED=false

# Duration Configuration
DEFAULT_VIDEO_DURATION_MINUTES=10
TEST_VIDEO_DURATION_MINUTES=3

# Image Requirements
IMAGE_MIN_WIDTH=1920
IMAGE_MIN_HEIGHT=1080
IMAGE_TARGET_ASPECT_RATIO=1.7777
IMAGE_ASPECT_TOLERANCE=0.08

# Video Requirements
VIDEO_MIN_DURATION_SECONDS=3

# Captions
CAPTIONS_ENABLED=true
CAPTION_MAX_WORDS=5

# Motion
MOTION_ENABLED=true
MOTION_BLUR_ENABLED=false

# Transitions
VIDEO_TRANSITION_SECONDS=1.5
AUDIO_CROSSFADE_SECONDS=4

# Audio
MUSIC_VOLUME=0.15
NARRATION_VOLUME=1.0
DUCKING_DB=-6

# YouTube Upload
YOUTUBE_UPLOAD_ENABLED=false

# Logging
LOG_LEVEL=INFO

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Database
DATABASE_PATH=jobs/registry.db

# Development
DEBUG=false

# Optional local OpenAI-compatible model routing (no new account required)
LLM_PROVIDER=gemini
OMNIROUTE_BASE_URL=http://localhost:8787
OMNIROUTE_MODEL=auto/best-fast
OMNIROUTE_API_KEY=
# The supplied youtube_token.json is a Google CLIENT configuration, not a token.
YOUTUBE_CLIENT_SECRETS_FILE=youtube_token.json
YOUTUBE_TOKEN_FILE=jobs/youtube_token.json
YOUTUBE_AUTO_SCHEDULE_ENABLED=true
YOUTUBE_VIDEOS_PER_DAY=2
YOUTUBE_SCHEDULE_TIME_1=09:00
YOUTUBE_SCHEDULE_TIME_2=18:00
# For >2 daily videos provide enough comma-separated local times.
YOUTUBE_SCHEDULE_TIMES=
YOUTUBE_TIMEZONE=Asia/Kolkata
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY=10
YOUTUBE_LANGUAGE=en
SUBSCRIBE_ANIMATION_DURATION=4
# Defaults preserve arbitrary source videos. Supplied clip uses 0.35 / 0.33.
SUBSCRIBE_CROP_HEIGHT_RATIO=1
SUBSCRIBE_CROP_TOP_RATIO=0
SUBSCRIBE_CROP_WIDTH_RATIO=1
SUBSCRIBE_CROP_LEFT_RATIO=0
SUBSCRIBE_WHITE_KEY_ENABLED=false
POLLINATION_IMAGE_ENABLED=false

JAZZ_PORT=5001
YOUTUBE_PROCESSING_POLL_INTERVAL=30
YOUTUBE_PROCESSING_TIMEOUT=1800

# Camping With Blues creative direction
CHANNEL_BRAND_NAME=Camping With Blues
SONG_PANEL_ENABLED=false
WAVEFORM_SCALE=2
VISUAL_EFFECT=old_film
VISUAL_EFFECT_OPACITY=0.06

# Visual footprint independent of the legacy width scale
WAVEFORM_STYLE=linear
WAVEFORM_VISUAL_HEIGHT_RATIO=0.30
VIDEO_ENCODER=auto
VIDEO_ENCODER_QUALITY=18
WAVEFORM_MIN_AMPLITUDE=0.06

# Local resource protection; output resolution, FPS and quality are unchanged.
RENDER_CPU_THREADS=2
RENDER_CPU_HIGH_PERCENT=90
RENDER_PRESSURE_SECONDS=30
RENDER_GPU_MAX_TEMPERATURE=85

# Immutable assets: no image/thumbnail generation in the long-form pipeline.
# Conservative process-wide render cap; jobs retain resolution and quality.
RENDER_MAX_CONCURRENT=1
# Legacy segmented renderer setting; production encodes one short branded clip.
# MUSIC_CROSSFADE_SECONDS selects its duration (bounded to 4-8 seconds).
# The background loop uses stream copy. Visualizer OFF also stream-copies the final mux.
# Visualizer ON composites the independent six-second asset during final encoding.
RENDER_SEGMENT_SECONDS=600
# Legacy waveform/GIF fields remain for saved-setting compatibility only.
WAVEFORM_ANIMATED=false

# VISUALIZER_ENABLED controls the new six-second animation. GIF paths are unused.
VISUALIZER_ENABLED=true
VISUALIZER_MUSIC_DISK_PATH=asset/music-disk.gif
VISUALIZER_SOUNDWAVE_PATH=asset/soundwave.gif
VISUALIZER_COMBINED_WIDTH_RATIO=0.25
VISUALIZER_OPACITY=1.0
# none, vintage, old_film, warm_film, faded_film, noir, sepia,
# film_grain, cool_cinematic, soft_vignette. 0 disables the effect.
# VISUAL_EFFECT=vintage
# VISUAL_EFFECT_OPACITY=0.06

# Six-second waveform size and bottom-left margins (420x110, 60px margins at 1080p).
VISUALIZER_LOOP_WIDTH_RATIO=0.21875
VISUALIZER_LEFT_PADDING_RATIO=0.03125
VISUALIZER_LOOP_BOTTOM_PADDING_RATIO=0.055556

QUALITY_PRESET=1080p
SUBSCRIBE_OVERLAY_INTERVAL_SECONDS=180

# ==========================================================================
# Narrated long-form AI studio (sibling to the jazz pipeline)
# Script (LLM) -> local approval -> TTS -> character bible + references ->
# reference-conditioned scene images -> FFmpeg -> validation/export
# ==========================================================================
NARRATION_ENABLED=false
NARRATION_REMOTE_ENABLED=false
NARRATION_TARGET_DURATION_MINUTES=10
NARRATION_SCENE_SECONDS=2.5
# Scene count is derived from duration (~2.5s per image); these are safety rails.
NARRATION_MIN_SCENES=1
NARRATION_MAX_SCENES=6000
NARRATION_MANIFEST_BATCH_SIZE=20
NARRATION_MAX_RETRIES=3
NARRATION_MOTION=kenburns
NARRATION_MOTION_STRENGTH=0.08
# Cinematic painterly documentary illustration. No stick figures, no 2D cartoon.
NARRATION_STYLE_PREFIX=Cinematic painterly documentary illustration, textured gouache and oil brushwork, natural warm light with deep atmospheric shadows, muted earth tones lifted by one warm accent colour, detailed but slightly stylized historical reconstruction, expressive faces and readable silhouettes, layered foreground and background depth, 16:9, no text, no lettering, no logos, no watermark
# Optional creative direction. The persistent character bible is generated per script.
NARRATION_CREATIVE_DIRECTION=
NARRATION_CHARACTERS=
NARRATION_NEGATIVE_PROMPT=3d render, cartoon, anime, stick figure, line art, flat vector, photo texture, hard gradients, text, words, letters, numbers, caption, watermark, signature, logo, blurry, low quality, deformed, extra limbs, malformed hands, duplicate person
# Seeds are deterministic: 0 still derives a stable seed from prompt/identity.
NARRATION_SEED=0
NARRATION_EXPORT_DIR=output/narration
NARRATION_EXPORT_ENABLED=true
NARRATION_VIDEO_ENCODER=

# Narration LLM routing (kept separate from LLM_PROVIDER)
# auto tries openrouter -> gemini -> omniroute using whichever key is present.
# Free OpenRouter slugs rotate and are shared/rate-limited; check
# https://openrouter.ai/models?max_price=0 and override if these 404 or 429.
NARRATION_LLM_PROVIDER=auto
NARRATION_LLM_MODEL=
NARRATION_OPENROUTER_MODEL=google/gemma-4-31b-it:free
NARRATION_LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
NARRATION_LLM_TIMEOUT_SECONDS=120
NARRATION_LLM_MAX_RETRIES=2
# true = offline test script when no LLM key is configured (not for production).
NARRATION_SCRIPT_FALLBACK=false
# Optional narration-specific keys. Fall back to OPENROUTER_API_KEY/GEMINI_API_KEY.
OPENROUTER_API_KEY_NARRATOR=
GEMINI_API_KEY_NARRATOR=
OMNIROUTE_API_KEY_NARRATOR=

# Image backend: diffusers (reference-conditioned, default) or comfyui.
NARRATION_IMAGE_BACKEND=diffusers
NARRATION_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
NARRATION_IMAGE_VAE=
NARRATION_IMAGE_WIDTH=1024
NARRATION_IMAGE_HEIGHT=576
NARRATION_IMAGE_STEPS=28
NARRATION_IMAGE_GUIDANCE=6.5
NARRATION_IMAGE_DEVICE=auto
NARRATION_IMAGE_DTYPE=float16
NARRATION_IMAGE_CPU_OFFLOAD=true
NARRATION_IP_ADAPTER_REPO=h94/IP-Adapter
NARRATION_IP_ADAPTER_SUBFOLDER=sdxl_models
NARRATION_IP_ADAPTER_WEIGHT=ip-adapter-plus_sdxl_vit-h.safetensors
NARRATION_IP_ADAPTER_SCALE=0.65
NARRATION_REFERENCE_VIEWS=full_body,portrait
NARRATION_REFERENCE_WIDTH=832
NARRATION_REFERENCE_HEIGHT=1216
NARRATION_REFERENCE_STEPS=32
NARRATION_THUMBNAIL_WIDTH=1280
NARRATION_THUMBNAIL_HEIGHT=720
NARRATION_QUALITY_ENABLED=true
NARRATION_QUALITY_MIN_STDDEV=10
NARRATION_QUALITY_MIN_ENTROPY=3
NARRATION_DUPLICATE_HAMMING_THRESHOLD=4
NARRATION_IDENTITY_CHECK_ENABLED=true
NARRATION_IDENTITY_MIN_SIMILARITY=0.40
NARRATION_IDENTITY_RETRY_SCALE_BOOST=0.15
NARRATION_MANIFEST_REUSE=true

# Remote RunPod audio services (optional when using piper_local)
# Kokoro-FastAPI (OpenAI-compatible): https://<pod>-8880.proxy.runpod.net
NARRATION_TTS_URL=
NARRATION_TTS_MODEL=kokoro
NARRATION_TTS_VOICE=af_heart
NARRATION_TTS_FORMAT=wav
NARRATION_TTS_SPEED=1.0
NARRATION_TTS_TIMEOUT_SECONDS=900
NARRATION_TTS_API_KEY=
# WhisperX HTTP aligner returning {"segments":[{"start","end","text","words":[...]}]}
NARRATION_ALIGN_URL=
NARRATION_ALIGN_TOKEN=
NARRATION_ALIGN_TIMEOUT_SECONDS=900

# In-process audio backends
NARRATION_TTS_BACKEND=http
NARRATION_ALIGN_BACKEND=http
NARRATION_KOKORO_LANG=a
NARRATION_KOKORO_SAMPLE_RATE=24000
# Piper local TTS (free, CPU-friendly; used by the Colab smoke test)
NARRATION_PIPER_BINARY=piper
NARRATION_PIPER_MODEL=
NARRATION_PIPER_CONFIG=
NARRATION_PIPER_SPEAKER=
NARRATION_PIPER_SAMPLE_RATE=22050
# 1.0 is the voice's natural pace (~170 wpm for lessac-medium).
# Raise it (measured ~1.17 -> ~9.3 min for a 1,444-word script) to stretch
# local Piper narration toward a longer target; verify the probed duration,
# because sentence pauses do not scale linearly with the length scale.
NARRATION_PIPER_LENGTH_SCALE=1.0

# Optional Hugging Face token for gated model/voice downloads.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

NARRATION_WHISPERX_MODEL=large-v3
NARRATION_WHISPERX_DEVICE=cuda
NARRATION_WHISPERX_COMPUTE_TYPE=float16

# Pod batch runner + local client
NARRATION_BATCH_WORKSPACE=/workspace/batches
POD_BATCH_HOST=0.0.0.0
POD_BATCH_PORT=8000
# Local machine: the pod batch server URL (https://<POD_ID>-8000.proxy.runpod.net)
POD_BATCH_URL=
POD_BATCH_TOKEN=
POD_BATCH_POLL_SECONDS=3

# ComfyUI (direct HTTP + WebSocket on the exposed RunPod port)
COMFY_BASE_URL=
COMFY_WS_URL=
COMFY_WORKFLOW_PATH=workflows/flux_schnell_api.json
# JSON override of node->input wiring; empty uses the shipped template defaults
COMFY_INPUT_MAP=
COMFY_TIMEOUT_SECONDS=600
COMFY_POLL_INTERVAL_SECONDS=2
COMFY_STEPS=4
COMFY_CFG=1.0
COMFY_SAMPLER=euler
COMFY_SCHEDULER=simple
COMFY_NEGATIVE_PROMPT_ENABLED=true

# Silent subscribe WebM; optional SUBSCRIBE_OVERLAY_START_AFTER_SECONDS defaults to the interval.
SUBSCRIBE_OVERLAY_PATH=subscribeVideo
SUBSCRIBE_OVERLAY_FILE=
SUBSCRIBE_OVERLAY_RIGHT_PADDING_RATIO=0.05
SUBSCRIBE_OVERLAY_BOTTOM_PADDING_RATIO=0.065
STUDIO_MOTION_MODE=drift
DUST_ENABLED=true
DUST_OPACITY=0.12
